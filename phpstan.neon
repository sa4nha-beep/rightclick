includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # DoD5 — PHPStan level 6 wajib bersih sebelum task dinyatakan selesai.
    level: 6

    paths:
        - app
        - config
        - database
        - routes

    # Berkas placeholder struktur direktori Clean Architecture.
    excludePaths:
        - app/**/.gitkeep

    ignoreErrors:
        # T1.3 sempat mengabaikan `trait.unused` untuk seluruh
        # `Concerns/*.php` — dihapus di T3.4: `HasDocumentState` (trait
        # fondasi terakhir yang belum dipakai model nyata) mulai dikonsumsi
        # `StockOpname`, jadi seluruh trait di direktori ini sekarang benar-
        # benar terpakai dan aturan abaikan itu sudah basi (PHPStan menandai
        # ignoreErrors yang tidak lagi cocok sebagai error tersendiri).
        -
            # Larastan generic type inference for Eloquent relationships.
            # False positive — method bodies match return type declarations.
            identifier: generics.lessTypes
            path: app/Infrastructure/Persistence/Models/*.php
        -
            # Larastan generic type inference for Eloquent relationships.
            # False positive — method bodies match return type declarations.
            identifier: return.type
            path: app/Infrastructure/Persistence/Models/*.php
