# RIGHTCLICK — contoh environment.
# S3: secret tidak pernah masuk repositori. Berkas ini hanya berisi placeholder.
# Salin menjadi `.env`, lalu jalankan `php artisan key:generate`.

APP_NAME=RIGHTCLICK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://rightclick.localhost:8443

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# DB Design 7 — timestamptz disimpan UTC, ditampilkan Asia/Jakarta.
# Jangan mengubah APP_TIMEZONE untuk kebutuhan tampilan.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Identitas node (HS-ARCH-RIGHTCLICK-v1.1 bagian 1.1)
# ---------------------------------------------------------------------------
# hq     → satu-satunya penulis master data
# branch → master data read-only, transaksi dikirim ke HQ lewat outbox
RIGHTCLICK_NODE_ROLE=branch
RIGHTCLICK_BRANCH_CODE=HK-A
RIGHTCLICK_DISPLAY_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# Caddy — HTTPS internal (S2)
# ---------------------------------------------------------------------------
APP_DOMAIN=rightclick.localhost
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# PostgreSQL 16
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rightclick
DB_USERNAME=rightclick
DB_PASSWORD=rightclick
# Port yang dipetakan ke loopback host untuk perkakas (S1 — tidak pernah ke internet)
DB_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis — antrean & cache
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sesi disimpan di database: tabel `sessions` berkelas LOCAL per node,
# dan sesi harus bertahan saat Redis dimulai ulang.
# Idle timeout 8 jam untuk back office (HS-ARCH bagian 3).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Backup (T1.12, CLAUDE.md §14) — pg_dump harian, enkripsi, off-site
# ---------------------------------------------------------------------------
# WAJIB diisi sebelum Fase 1 dinyatakan selesai. Tanpa ini, backup gagal
# dengan sengaja (fail-safe) — dump tidak pernah tersimpan tanpa enkripsi.
BACKUP_ENCRYPTION_PASSPHRASE=
# rclone remote:path, mis. "b2:haen-rightclick-backup/HK-A" — lihat
# docker/backup/rclone.conf.example untuk konfigurasi backend off-site.
# Kosong = backup tetap berjalan tapi HANYA tersimpan lokal (peringatan di log).
BACKUP_OFFSITE_REMOTE=
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12
# Cron, dievaluasi pada TZ=RIGHTCLICK_DISPLAY_TIMEZONE (bukan UTC) — wajib
# di luar jam operasional toko.
BACKUP_SCHEDULE_DAILY="0 2 * * *"
BACKUP_SCHEDULE_RESTORE_TEST="0 3 1 * *"

VITE_APP_NAME="${APP_NAME}"
