<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" WAJIB pada setiap baris di bawah. Tanpanya, PHPUnit
            tidak menimpa environment variable yang sudah ada di proses induk
            — dan docker-compose.yml men-set APP_ENV/DB_DATABASE/dst. dari
            .env (env_file) di level container SEBELUM PHPUnit sempat
            berjalan. Akibatnya (ditemukan T1.11): seluruh test suite diam-
            diam berjalan di atas database `rightclick` (dev), BUKAN
            `rightclick_testing` — bertahun-tahun tanpa error karena
            RefreshDatabase membungkus tiap test dalam transaksi yang
            di-rollback, tapi tetap melanggar B3 (CLAUDE.md §18) dan
            membuat helper yang memeriksa app()->runningUnitTests() (dipakai
            Filament untuk testing form) selalu bernilai false karena
            APP_ENV terbaca "local", bukan "testing".
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>

        <!--
            Pengujian berjalan di atas PostgreSQL 16, bukan SQLite.
            Skema RIGHTCLICK bergantung pada CHECK constraint, indeks unik
            parsial, numeric(18,2), jsonb, dan SELECT ... FOR UPDATE
            (DB Design C1-C15, R6, R7). SQLite akan meloloskan pelanggaran
            yang ditolak produksi.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="rightclick_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
